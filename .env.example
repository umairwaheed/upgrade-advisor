# AWS region hosting your AgentCore resources + Bedrock model access.
AWS_REGION=us-west-2

# Bedrock model the agent reasons with.
# If Opus 5 isn't enabled in your account, `global.anthropic.claude-sonnet-4-6`
# is Strands' own default and a safe fallback. Discover what you can call with:
#   aws bedrock list-inference-profiles --region $AWS_REGION \
#     --query 'inferenceProfileSummaries[?contains(inferenceProfileId,`anthropic`)].inferenceProfileId'
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5

# Created by `python setup_memory.py` — paste the printed id here.
AGENTCORE_MEMORY_ID=

# Who the memory is scoped to. One namespace per team.
UPGRADE_ADVISOR_ACTOR=platform-team
